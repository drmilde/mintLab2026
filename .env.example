# ============================================================
#  Comic Maker - Konfiguration
#  Alle "versteckten" System-Prompts und Server-Adressen
#  werden hier gepflegt (python-dotenv).
# ============================================================

# ---------- Ollama (Text / Drehbuch) ----------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_TIMEOUT=300
OLLAMA_TEMPERATURE=0.8
OLLAMA_NUM_PREDICT=1600

# ---------- ComfyUI / Krea2 (Bildgenerierung) ----------
# Basis-Adresse des ComfyUI-Servers
COMFY_SERVER_URL=http://127.0.0.1:8188
# Workflow im API-Format (relativ zum Projektordner oder absolut)
COMFY_WORKFLOW=krea2.json
COMFY_TIMEOUT=900
# Erwartete Dauer eines Bild-Jobs in Sekunden (nur Fortschrittsbalken)
COMFY_EXPECTED_SECONDS=240
# Comic-Seite: Hochformat
COMFY_PAGE_ASPECT_RATIO=3:4 (Portrait Standard)
COMFY_PAGE_MEGAPIXELS=1.5
COMFY_PAGE_STEPS=8
# Signatur-Logo: Quadrat, klein und schnell
COMFY_SIGNATURE_ASPECT_RATIO=1:1 (Square)
COMFY_SIGNATURE_MEGAPIXELS=1.0
COMFY_SIGNATURE_STEPS=8
# LoRA "krea2_darkbrush" aktivieren (true/false)
COMFY_ENABLE_LORA=false
# Prompt vom Textmodell im Workflow ausformulieren lassen (true/false)
COMFY_REFINE_PROMPT=false

# Legacy / alternativer Bild-Endpunkt (nicht genutzt, nur Referenz)
IMAGE_GEN_API_URL=http://localhost:7860/sdapi/v1/txt2img

# ---------- Druckserver ----------
PRINT_SERVER_HOST=print-server.local
PRINT_SERVER_PORT=80
PRINT_SERVER_SCHEME=http
PRINT_SERVER_ENDPOINT=/api/v1/upload
PRINT_SERVER_TIMEOUT=60
# Optional: kompletter URL, überschreibt Host/Port/Endpoint wenn gesetzt
PRINT_SERVER_URL=

# ---------- Ausgabe ----------
OUTPUT_DIR=output

# ---------- Gradio ----------
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7861
GRADIO_SHARE=false

# ============================================================
#  Versteckter Kontext / System-Prompts
# ============================================================

SYSTEM_PROMPT_GERMAN="Du bist ein kreativer Comic-Autor für Jugendliche..."

PANEL_FORMAT_PROMPT="Gib das Drehbuch als Markdown aus. Benutze für JEDES Panel exakt dieses Format und keine weiteren Überschriften:\n\n## Panel 1\n**Bildbeschreibung:** <was man im Bild sieht, 1-2 Sätze, nenne die Figuren beim Namen>\n**Erzähler-Text:** <kurzer Erzähltext, maximal 15 Wörter>\n**Sprechblasen:**\n- <Figurenname>: \"<kurzer Satz, maximal 12 Wörter>\"\n- <Figurenname>: \"<kurzer Satz, maximal 12 Wörter>\"\n\nWiederhole diesen Block für alle Panels. Wenn in einem Panel niemand spricht, schreibe unter Sprechblasen genau eine Zeile: - (keine)"

IMAGE_STYLE_PROMPT="clean modern comic book page, bright friendly colors, bold black ink outlines, flat cel shading, cheerful all-ages illustration style, clearly separated rectangular panels with white gutters and thin black borders, speech balloons with white background and readable hand-lettered German text, caption boxes at the top of each panel"

IMAGE_NEGATIVE_HINTS="no gore, no scary content, no photorealism, no text errors outside balloons, no watermark"

SIGNATURE_STYLE_PROMPT="street art graffiti tag logo, spray paint style, bold colorful letters with thick black outline and highlights, centered on a plain white background, sticker look, high contrast, vector-like clean edges"
